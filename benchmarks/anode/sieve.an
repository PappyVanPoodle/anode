// Sieve of Eratosthenes: counts the primes up to 2,000,000.
fn count_primes(limit: int) -> int {
    let mut composite = ints();
    for i in 0..limit + 1 { push(composite, 0); }
    let mut count = 0;
    for p in 2..limit + 1 {
        if at(composite, p) == 0 {
            count = count + 1;
            let mut m = p * p;
            while m <= limit { set(composite, m, 1); m = m + p; }
        }
    }
    return count;
}
fn main() { print count_primes(2000000); }
