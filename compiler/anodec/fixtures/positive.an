pub struct Entry { value:int, label:text }
vector Entries(Entry);
map Index(text,int);
enum Event { Ready(Entry), Empty }
impl Entry { pub fn score(self:&Self)->int { return self.value; } }
fn take(value:text)->int { return len(value); }
fn main() {
    let mut entries=Entries();
    push(entries,Entry{value:7,label:"café"});
    borrow mut entry=at(entries,0) { entry.value=entry.value+1; }
    for entry in &mut entries { entry.value=entry.value+1; }
    for item in &entries { print item.score(); }
    let mut index=Index(); insert(index,"first",7);
    borrow number=get(index,"first") { assert number==7; }
    borrow mut number=get(index,"first") { number=number+1; }
    let event=Event::Empty();
    match &event { Event::Ready(item)=>{print item.value;} _=>{} }
    let mut changed=Event::Ready(Entry{value:9,label:"changed"});
    match &mut changed { Event::Ready(item)=>{item.value=10;} _=>{} }
    let source="view";
    borrow view=region(source,0,4) { let independent=to_text(view); print independent; }
    let kept="retained"; let length=take(clone(kept)); assert length==8; print kept;
    for i in 0..2 { if i==0 { continue; } else if i==1 { print i; } else {} }
}
