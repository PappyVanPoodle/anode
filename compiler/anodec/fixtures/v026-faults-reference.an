// BEHAVIOR-EQUIVALENT 0.25 ORACLE. Guard source uses subtraction to avoid addition overflow.
vector Values(int);
fn checked(length:int,start:int,count:int) { if start<0 || count<0 || start>length || count>length-start { let bounds=[0];print at(bounds,2); } }
fn main() {
    let mut values=Values();push(values,10);push(values,20);push(values,30);let mode=arg(0);let n=parse_int(arg(1));
    if text_eq(mode,"start") { checked(len(values),n,1);print 1; }
    else if text_eq(mode,"count") { checked(len(values),1,n);print n; }
    else if text_eq(mode,"nested") { checked(len(values),1,1);checked(1,0,n);print n; }
    else if text_eq(mode,"index") { let fixed=[20];print at(fixed,n); }
    else if text_eq(mode,"pair") { borrow mut (a,b)=at_pair(values,0,n) { a=a+1;b=b+2; } }
    else if text_eq(mode,"legacy") { let fixed=[10,20,30];borrow view=region(fixed,1,n) { print len(view); } }
}
