vector Values(text);
map Entries(text,text);
arena Slots(text);
fn main() {
    let mode=arg(0);let value=arg(1);
    if text_eq(mode,"overflow") { let number=parse_int(value);print number+1; }
    else if text_eq(mode,"bounds") { let mut values=Values();push(values,"owner");let number=parse_int(value);print clone_at(values,number); }
    else if text_eq(mode,"utf8") { let source="cafÃ©";let number=parse_int(value);print slice(source,number,5); }
    else if text_eq(mode,"divide") { let number=parse_int(value);print 10/number; }
    else if text_eq(mode,"missing") { let mut entries=Entries();insert(entries,"present","owned");print clone_get(entries,value); }
    else if text_eq(mode,"arena-stale") { let mut slots=Slots();let h=alloc(slots,"owned");let removed=free(slots,h);print clone_get(slots,h); }
    else if text_eq(mode,"arena-empty-owner") { let mut slots=Slots();let mut other=Slots();let h=alloc(other,"owned");borrow text=get(slots,h){print text;} }
    else { print parse_int(value); }
}
