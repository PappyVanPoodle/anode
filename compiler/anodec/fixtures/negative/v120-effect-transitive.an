// bounded propagates over the call graph: fold recurses directly, so neither
// fold nor its caller seal can acquire the proof; seal is reported first.
@effect(no_alloc, no_io, bounded)
fn seal(frame:&[u8;8])->u32 { return fold(&frame,0); }
@effect(no_alloc, no_io, bounded)
fn fold(frame:&[u8;8],i:int)->u32 { if i>=8 { return u32(0); } return wrapping_add(u32(at(frame,i)),fold(&frame,i+1)); }
fn main(){let frame=[u8(2);8];print seal(&frame);}
