fn place_type(program:&crate::ast::Program,report:&crate::checker::Report,state:&State,unit:int,index:int,depth:int)->text {
    if depth>96 { return "?"; }borrow ast_unit_5=at(program.units,unit) { borrow node=at(ast_unit_5.tree.nodes,index) {
    if node.kind==30 && contains_key(state.types,node.name) { return clone_get(state.types,node.name); }
    if node.kind==36 { let owner=place_type(&program,&report,&state,unit,at(node.children,0),depth+1);return field_type(&program,&report,&owner,&node.name); }
