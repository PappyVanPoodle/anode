    if !contains_key(report.symbols,base) { return -1; }
    let symbol=clone_get(report.symbols,base);borrow ast_unit_1=at(program.units,symbol.unit) { borrow declaration=at(ast_unit_1.tree.nodes,symbol.node) {
    for i in 0..len(declaration.children) { borrow ast_unit_2=at(program.units,symbol.unit) { borrow field=at(ast_unit_2.tree.nodes,at(declaration.children,i)) {if text_eq(field.name,name) { return i; } } } }
    return -1;
} } }
fn field_type(program:&crate::ast::Program,report:&crate::checker::Report,typ:&text,name:&text)->text {
    let base=crate::ast::base(&typ);
    if text_eq(base,"ProcessOutput") { if text_eq(name,"status") { return "int"; } if text_eq(name,"stdout") || text_eq(name,"stderr") { return "text"; } return "?"; }
    if !contains_key(report.symbols,base) { return "?"; }
    let symbol=clone_get(report.symbols,base);borrow ast_unit_3=at(program.units,symbol.unit) { borrow declaration=at(ast_unit_3.tree.nodes,symbol.node) {let module=crate::ast::module_name(&program,symbol.unit);
    for i in 0..len(declaration.children) { borrow ast_unit_4=at(program.units,symbol.unit) { borrow field=at(ast_unit_4.tree.nodes,at(declaration.children,i)) {if text_eq(field.name,name) { return canonical(&program,&module,&field.typ); } } } }
    return "?";
