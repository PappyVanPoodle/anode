    let source=at(node.children,0);borrow ast_unit_30=at(program.units,unit) { borrow value_node=at(ast_unit_30.tree.nodes,source) {let reference=value_node.kind==38 && text_starts_with(value_node.name,"&");let mut value="";let mut root="";
    if reference { value=place(&program,&report,&mut state,unit,at(value_node.children,0),0);root=origin(&program,&state,unit,source,0); }
    else { let computed=expression(&program,&report,&mut state,unit,source,true,0);let variable=fresh(&mut state,"m");line(&mut state,["B ",clone(variable),"=b_take(",computed,");"]);push(state.owns,clone(variable));value=concat("&",variable); }
    let match_pointer=fresh(&mut state,"e");line(&mut state,["B* ",clone(match_pointer),"=b_resolve(",value,");"]);drop_temps(&mut state,0);let module=crate::ast::module_name(&program,unit);
    for i in 1..len(node.children) {
        borrow ast_unit_31=at(program.units,unit) { borrow arm=at(ast_unit_31.tree.nodes,at(node.children,i)) {let mut prefix="if";if i>1 { prefix="else if"; }
        if text_eq(arm.name,"_") { if i==1 { line(&mut state,["{"]); }else { line(&mut state,["else {"]); } }
        else { let mut key=crate::ast::resolve(&program,&module,&arm.name);if text_starts_with(arm.name,"ReadResult::") || text_starts_with(arm.name,"ProcessRun::") { key=clone(arm.name); }let tag=variant_tag(&program,&report,&key);line(&mut state,[prefix,"(",clone(match_pointer),"->i==",int_text(tag),"){"]); }
        let saved=len(state.owns);
        if len(arm.typ)>0 {
            let mut key=crate::ast::resolve(&program,&module,&arm.name);let mut typ="text";
            if text_eq(arm.name,"ProcessRun::Output") { typ="ProcessOutput"; }
            else if !text_starts_with(arm.name,"ReadResult::") && !text_starts_with(arm.name,"ProcessRun::") { let symbol=clone_get(report.symbols,key);borrow ast_unit_32=at(program.units,symbol.unit) { borrow variant=at(ast_unit_32.tree.nodes,symbol.node) {let origin_module=crate::ast::module_name(&program,symbol.unit);typ=canonical(&program,&origin_module,&variant.typ); } } }
            let payload=cat(["b_at(",clone(match_pointer),",0)"]);
            if reference { bind(&mut state,clone(arm.typ),payload,typ,clone(root)); }
            else { let moved=temp(&mut state,cat(["b_take(",payload,")"]));local(&mut state,clone(arm.typ),typ,moved);drop_temps(&mut state,0); }
        }
        statement(&program,&report,&mut state,unit,at(arm.children,0),depth+1);close_owners(&mut state,saved);state.names=clone(names);state.types=clone(types);state.roots=clone(roots);line(&mut state,["}"]);
    } } }
    close_owners(&mut state,mark);state.names=names;state.types=types;state.roots=roots;line(&mut state,["}"]);
} } }
fn signature(program:&crate::ast::Program,unit:int,index:int)->text {
    borrow ast_unit_33=at(program.units,unit) { borrow node=at(ast_unit_33.tree.nodes,index) {let mut parameters=texts();for i in 0..len(node.children)-1 { push(parameters,concat("B* p",int_text(i))); }
    if len(parameters)==0 { push(parameters,"void"); }return cat(["static B ",function_name(unit,index),"(",text_join(parameters,","),")"]);
} } }
fn supported_type(typ:&text)->bool {
    let base=crate::ast::base(&typ);return !text_eq(base,"f32");
}
pub fn emit(program:&crate::ast::Program,report:&crate::checker::Report)->Emission { return emit_with_options(&program,&report,false); }
// v1.4: debug_lines adds `#line <n> "<unit path>"` before every function and
// statement so MSVC /Zi maps the PDB back to .an sources; false is the exact
// historical C. emit_tests lowers `test` blocks plus a runner wmain instead.
pub fn emit_with_options(program:&crate::ast::Program,report:&crate::checker::Report,debug_lines:bool)->Emission { return emit_program(&program,&report,debug_lines,false); }
pub fn emit_tests(program:&crate::ast::Program,report:&crate::checker::Report,debug_lines:bool)->Emission { return emit_program(&program,&report,debug_lines,true); }
// Test i runs alone when argv[1] is i (anodec test isolates each test in its
// own process); without an argument every test runs in declaration order.
pub fn test_names(program:&crate::ast::Program)->texts {
    let mut names=texts();
    for unit in &program.units {
        for i in 0..len(unit.tree.roots) { borrow node=at(unit.tree.nodes,at(unit.tree.roots,i)) { if node.kind==6 && node.flag==2 { push(names,test_label(&unit.name,&node.name)); } } }
    }
    return names;
}
fn test_label(module:&text,name:&text)->text { if text_eq(module,"main") { return clone(name); } return cat([clone(module),"::",clone(name)]); }
fn c_path(path:&text)->text {
    let mut parts=texts();let mut i=0;
    while i<len(path) { let c=byte_at(path,i);let end=next_char_boundary(path,i);
        if c==92 { push(parts,"\\\\"); }else if c==34 { push(parts,"\\\""); }else if c<32 { push(parts,"_"); }else { push(parts,slice(path,i,end)); }i=end;
    }
    return text_join(parts,"");
}
fn debug_line(program:&crate::ast::Program,state:&mut State,unit:int,pos:int) {
    if !state.debug { return; }
    borrow source=at(program.units,unit) { let number=crate::ast::line_of(&source.tree.lines,pos);line(&mut state,["#line ",int_text(number)," \"",c_path(&source.path),"\""]); }
}
fn emit_program(program:&crate::ast::Program,report:&crate::checker::Report,debug_lines:bool,tests:bool)->Emission {
    let mut output=texts();let mut diagnostics=texts();let mut entry="";let mut helper_seen=Names();let mut helpers=texts();let mut runners=texts();
    let mut prelude=texts();push(prelude,"/* Deterministic Stage1 C, emitted by src/cgen.an. */\n#include \"bvalue.h\"");
    for unit in 0..len(program.units) {
        borrow source=at(program.units,unit) {
            for i in 0..len(source.tree.roots) { let index=at(source.tree.roots,i);borrow ast_unit_34=at(program.units,unit) { borrow node=at(ast_unit_34.tree.nodes,index) {if node.kind==6 && (node.flag!=2 || tests) { push(output,concat(signature(&program,unit,index),";"));if node.flag!=2 && text_eq(node.name,"main") && !contains(source.name,"::") { if len(entry)>0 { push(diagnostics,"unsupported codegen: multiple main functions"); }entry=function_name(unit,index);if len(node.children)!=1 || !text_eq(node.typ,"unit") { push(diagnostics,"unsupported codegen: main must have no arguments and return unit"); } } } } } }
            for i in 0..len(source.tree.nodes) { let typ=inferred(&report,unit,i);if !supported_type(&typ) { borrow ast_unit_35=at(program.units,unit) { borrow node=at(ast_unit_35.tree.nodes,i) {push(diagnostics,cat([clone(source.path),":byte ",int_text(node.pos),": unsupported codegen numeric type ",typ])); } } } }
        }
    }
    if len(entry)==0 && !tests { push(diagnostics,"unsupported codegen: no main function"); }
    if len(diagnostics)>0 { return Emission{source:"",diagnostics:diagnostics}; }
    for unit in 0..len(program.units) {
        borrow source=at(program.units,unit) {
            for i in 0..len(source.tree.roots) {
                let index=at(source.tree.roots,i);borrow ast_unit_36=at(program.units,unit) { borrow node=at(ast_unit_36.tree.nodes,index) {if node.kind!=6 || (node.flag==2 && !tests) { continue; }
                if node.flag==2 {
                    let label=test_label(&source.name,&node.name);let shown=concat("test ",label);let number=int_text(len(runners));
                    push(runners,cat(["if(only<0||only==",clone(number),"){B produced=",function_name(unit,index),"();b_drop(&produced);b_clean();if(only<0){zn_text name={(char*)\"",clone(shown),"\",",int_text(len(shown)),"u};zn_print_text(name);}}"]));
                }
                let mut state=State{lines:texts(),names:Names(),types:Names(),roots:Names(),owns:texts(),temps:texts(),loops:[],next:0,error:"",error_at:0,helper_names:texts(),helper_defs:texts(),debug:debug_lines,source_lines:debug_lines || tests};debug_line(&program,&mut state,unit,node.pos);line(&mut state,[signature(&program,unit,index),"{b_enter();"]);
                for j in 0..len(node.children)-1 { let parameter_index=at(node.children,j);borrow ast_unit_37=at(program.units,unit) { borrow parameter=at(ast_unit_37.tree.nodes,parameter_index) {let pointer=concat("p",int_text(j));let typ=inferred(&report,unit,parameter_index);if text_starts_with(parameter.typ,"&") { bind(&mut state,clone(parameter.name),pointer,typ,clone(parameter.name)); }else { local(&mut state,clone(parameter.name),typ,pointer); } } } }
                statement(&program,&report,&mut state,unit,at(node.children,len(node.children)-1),0);drop_temps(&mut state,0);drop_owners(&mut state,0);line(&mut state,["b_leave();return b_unit();}"]);
                if len(state.error)>0 { push(diagnostics,cat([clone(source.path),":byte ",int_text(state.error_at),": ",clone(state.error)])); }else { push(output,text_join(state.lines,"\n")); }
                for k in 0..len(state.helper_names) { let helper=text_at(state.helper_names,k);if !contains_key(helper_seen,helper) { insert(helper_seen,clone(helper),"emitted");push(helpers,text_at(state.helper_defs,k)); } }
            } } }
        }
    }
    if len(diagnostics)>0 { return Emission{source:"",diagnostics:diagnostics}; }
    if tests { push(output,cat(["int wmain(int argc,wchar_t** argv){zn_args_init(argc,argv);int64_t only=argc>1?(int64_t)_wtoi64(argv[1]):-1;",text_join(runners,""),"return zn_process_exit_code();}\n"])); }
    else { push(output,cat(["int wmain(int argc,wchar_t** argv){zn_args_init(argc,argv);B produced=",entry,"();b_drop(&produced);b_clean();return zn_process_exit_code();}\n"])); }
    if len(helpers)>0 { push(prelude,"#include <intrin.h>");for k in 0..len(helpers) { push(prelude,text_at(helpers,k)); } }
    return Emission{source:cat([text_join(prelude,"\n"),"\n",text_join(output,"\n")]),diagnostics:diagnostics};
}

pub fn json_string(value:&text)->text {
    let mut parts=texts();push(parts,"\"");let mut i=0;
    while i<len(value) { let c=byte_at(value,i);let end=next_char_boundary(value,i);
        if c==34 { push(parts,"\\\""); }else if c==92 { push(parts,"\\\\"); }else if c==10 { push(parts,"\\n"); }else if c==13 { push(parts,"\\r"); }else if c==9 { push(parts,"\\t"); }
        else if c<32 { let digits="0123456789abcdef";push(parts,concat("\\u00",concat(slice(digits,c/16,c/16+1),slice(digits,c%16,c%16+1)))); }
        else { push(parts,slice(value,i,end)); }i=end;
    }
    push(parts,"\"");return text_join(parts,"");
}
pub fn build_manifest(program:&crate::ast::Program,c_file:&text)->text {
    let mut modules=texts();
    for unit in &program.units { push(modules,cat(["{\"name\":",json_string(&unit.name),",\"path\":",json_string(&unit.path),"}"])); }
    return cat(["{\n\"format\":\"anode-bootstrap-c-build-1\",\n\"path_base\":\"invocation_directory\",\n\"c_file\":",json_string(&c_file),",\n\"include_directories\":[\"codegen-runtime\"],\n\"runtime_sources\":[\"codegen-runtime/runtime.c\"],\n\"compile_options\":[\"/std:c11\",\"/utf-8\",\"/MD\"],\n\"native_options\":[\"/O2\"],\n\"asan_options\":[\"/O2\",\"/Zi\",\"/fsanitize=address\"],\n\"link_options\":[\"/INCREMENTAL:NO\",\"/STACK:67108864\"],\n\"modules\":[",text_join(modules,","),"]\n}\n"]);
}

test codegen_emits_real_functions_and_checked_operations() {
    let tree=crate::parser::parse("fn twice(value:int)->int{return value*2;}fn main(){print twice(9);}");let mut units=crate::ast::Units();push(units,crate::ast::Unit{name:"demo",path:"demo.an",tree:tree});let program=crate::ast::program(units);let report=crate::checker::check(&program);assert len(report.diagnostics)==0;
    let generated=emit(&program,&report);assert len(generated.diagnostics)==0;let marker="b_binary(\"*\"";assert contains(generated.source,marker);let again=emit(&program,&report);assert text_eq(generated.source,again.source);
}
test codegen_rejects_overlapping_call_references() {
    let tree=crate::parser::parse("fn alter(left:&mut text,right:&text){}fn main(){let mut value=\"a\";alter(&mut value,&value);}");let mut units=crate::ast::Units();push(units,crate::ast::Unit{name:"alias",path:"alias.an",tree:tree});let program=crate::ast::program(units);let report=crate::checker::check(&program);assert len(report.diagnostics)==0;
    let generated=emit(&program,&report);assert len(generated.diagnostics)>0;assert len(generated.source)==0;
}
test codegen_accepts_shared_aliases_and_scalar_snapshots() {
    let tree=crate::parser::parse("struct Value{items:ints,cursor:int}fn read(items:&ints,cursor:int,again:&ints)->int{return at(items,cursor)+len(again);}fn main(){let value=Value{items:[7],cursor:0};print read(&value.items,value.cursor,&value.items);}");let mut units=crate::ast::Units();push(units,crate::ast::Unit{name:"shared",path:"shared.an",tree:tree});let program=crate::ast::program(units);let report=crate::checker::check(&program);assert len(report.diagnostics)==0;
    let generated=emit(&program,&report);assert len(generated.diagnostics)==0;assert len(generated.source)>0;
}
test codegen_rejects_shared_alias_with_mutating_argument() {
    let tree=crate::parser::parse("fn change(value:&mut text)->int{value=\"changed\";return 1;}fn read(value:&text,count:int){}fn main(){let mut value=\"owner\";read(&value,change(&mut value));}");let mut units=crate::ast::Units();push(units,crate::ast::Unit{name:"alias",path:"alias.an",tree:tree});let program=crate::ast::program(units);let report=crate::checker::check(&program);assert len(report.diagnostics)==0;
    let generated=emit(&program,&report);assert len(generated.diagnostics)>0;assert len(generated.source)==0;
}
test codegen_rejects_shared_alias_with_owned_move() {
    let tree=crate::parser::parse("fn read(value:&text,owned:text){}fn main(){let value=\"owner\";read(&value,value);}");let mut units=crate::ast::Units();push(units,crate::ast::Unit{name:"alias",path:"alias.an",tree:tree});let program=crate::ast::program(units);let report=crate::checker::check(&program);assert len(report.diagnostics)==0;
    let generated=emit(&program,&report);assert len(generated.diagnostics)>0;assert len(generated.source)==0;
}
test codegen_rejects_unimplemented_numeric_widths() {
    let tree=crate::parser::parse("fn main(){let value=f32(7.0);print int(value);}");let mut units=crate::ast::Units();push(units,crate::ast::Unit{name:"narrow",path:"narrow.an",tree:tree});let program=crate::ast::program(units);let report=crate::checker::check(&program);assert len(report.diagnostics)==0;
    let generated=emit(&program,&report);assert len(generated.diagnostics)>0;assert len(generated.source)==0;
}

test codegen_emits_inline_width_intrinsic_helpers() {
    let tree=crate::parser::parse("fn main(){let small=u8(200);let wide=i32(-7);print rotl(small,3);print shr(wide,1);print bit_not(5);print rotl(small,1);}");let mut units=crate::ast::Units();push(units,crate::ast::Unit{name:"fast",path:"fast.an",tree:tree});let program=crate::ast::program(units);let report=crate::checker::check(&program);assert len(report.diagnostics)==0;
    let generated=emit(&program,&report);assert len(generated.diagnostics)==0;let rotate="static __forceinline B zn_v029_rotl_u8(B* a,B* b)";let call="=zn_v029_rotl_u8(";let shift="zn_v029_shr_i32(";let inverse="zn_v029_bit_not_int(";let intrinsic="_rotl8(";let generic="b_call(\"rotl\"";let header="#include <intrin.h>";
    assert contains(generated.source,rotate);assert contains(generated.source,call);assert contains(generated.source,shift);assert contains(generated.source,inverse);assert contains(generated.source,intrinsic);assert contains(generated.source,header);assert !contains(generated.source,generic);
    let pieces=split(generated.source,rotate);assert len(pieces)==2;let again=emit(&program,&report);assert text_eq(generated.source,again.source);
}
test codegen_lowers_only_proven_nonnegative_power_of_two_division() {
    let tree=crate::parser::parse("fn main(){let text=\"az\";let byte=byte_at(text,1);let count=len(text);print byte%16;print (byte+count)/8;let mut moved=byte;print moved%16;let negative=0-byte;print negative%4;print byte%6;for i in 0..4 { print i%2; }let narrow=u8(9);print narrow%u8(4);}");let mut units=crate::ast::Units();push(units,crate::ast::Unit{name:"pow2",path:"pow2.an",tree:tree});let program=crate::ast::program(units);let report=crate::checker::check(&program);assert len(report.diagnostics)==0;
    let generated=emit(&program,&report);assert len(generated.diagnostics)==0;let remainder="=zn_v029_rem_pow2(";let mask="UINT64_C(15)";let divide="=zn_v029_div_pow2(";let checked="b_binary(\"%\"";
    assert contains(generated.source,remainder);assert contains(generated.source,mask);assert contains(generated.source,divide);assert contains(generated.source,checked);
    let remainders=split(generated.source,remainder);let checks=split(generated.source,checked);assert len(remainders)==3;assert len(checks)==5;
}
test codegen_emits_columns_spans_and_build_manifest() {
    let tree=crate::parser::parse("struct Row{x:int}soa vector Rows(Row);vector Values(int);fn main(){let mut rows=Rows();push(rows,Row{x:1});let mut values=Values();push(values,2);borrow view=region(values,0,1){print len(view);}}");let mut units=crate::ast::Units();push(units,crate::ast::Unit{name:"demo",path:"demo.an",tree:tree});let program=crate::ast::program(units);let report=crate::checker::check(&program);assert len(report.diagnostics)==0;let generated=emit(&program,&report);assert len(generated.diagnostics)==0;let columns="b_soa(1)";let span="b_span(";assert contains(generated.source,columns);assert contains(generated.source,span);let output="path with spaces/target.c";let first=build_manifest(&program,&output);let second=build_manifest(&program,&output);assert text_eq(first,second);let marker="/STACK:67108864";assert contains(first,marker);
}

test codegen_splits_proven_big_endian_stores_from_checked_writes() {
    let tree=crate::parser::parse("@effect(no_alloc,no_io,bounded)\nfn frame(mut buf:[u8;16],offset:int)->[u8;16]{let ok=try_write_u32_be(buf,12,u32(1));for i in 0..3 { let lane=try_write_u32_be(buf,i*4,u32(2)); }let edge=try_write_u16_be(buf,15,u16(3));let moved=try_write_u64_be(buf,offset,u64(4));return buf;}fn main(){let packet=frame([u8(0);16],2);print read_u32_be(packet,12);}");let mut units=crate::ast::Units();push(units,crate::ast::Unit{name:"wire",path:"wire.an",tree:tree});let program=crate::ast::program(units);let report=crate::checker::check(&program);assert len(report.diagnostics)==0;
    let generated=emit(&program,&report);assert len(generated.diagnostics)==0;let proven="=zn_v120_store_u32_be(";let edge="=zn_v120_try_write_u16_be(";let moved="=zn_v120_try_write_u64_be(";let read="=zn_v120_read_u32_be(";let fixed="=zn_v120_fixed(";let checked="=zn_v120_try_write_u32_be(";let header="#include \"bprocess.h\"";
    assert contains(generated.source,edge);assert contains(generated.source,moved);assert contains(generated.source,read);assert contains(generated.source,fixed);assert !contains(generated.source,checked);assert !contains(generated.source,header);
    let stores=split(generated.source,proven);assert len(stores)==3;let again=emit(&program,&report);assert text_eq(generated.source,again.source);
}
test codegen_includes_process_support_only_for_process_run() {
    let tree=crate::parser::parse("fn main(){let args=texts();match process_run(\"tool\",&args){ProcessRun::Output(out)=>{print out.status;}ProcessRun::Error(message)=>{print message;}}}");let mut units=crate::ast::Units();push(units,crate::ast::Unit{name:"launch",path:"launch.an",tree:tree});let program=crate::ast::program(units);let report=crate::checker::check(&program);assert len(report.diagnostics)==0;
    let generated=emit(&program,&report);assert len(generated.diagnostics)==0;let header="#include \"bprocess.h\"";let call="=zn_v120_process_run(";assert contains(generated.source,header);assert contains(generated.source,call);
}
