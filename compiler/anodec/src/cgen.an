// Stage1 lowers checked AST bodies to real C functions. B owns a value; B* is
// a scoped alias. Generated operations never use restrict or raw unchecked access.
pub struct Emission { source:text, diagnostics:texts }
map Names(text,text);
struct State { lines:texts, names:Names, types:Names, roots:Names, owns:texts, temps:texts, loops:ints, next:int, error:text, error_at:int, helper_names:texts, helper_defs:texts, debug:bool, source_lines:bool }
// v0.29: private static __forceinline zn_v029_ helpers are emitted into the
// generated C (first-use order, deduplicated), never added to bvalue.h/runtime.
fn use_helper(state:&mut State,name:text,definition:text) { push(state.helper_names,name);push(state.helper_defs,definition); }
fn fast_type(typ:&text)->text {
    if text_eq(typ,"int") || text_eq(typ,"i64") { return "int"; }
    if text_eq(typ,"i8") || text_eq(typ,"i16") || text_eq(typ,"i32") || text_eq(typ,"u8") || text_eq(typ,"u16") || text_eq(typ,"u32") || text_eq(typ,"u64") { return clone(typ); }
    return "";
}
fn type_width(typ:&text)->int { if text_eq(typ,"i8") || text_eq(typ,"u8") { return 8; }if text_eq(typ,"i16") || text_eq(typ,"u16") { return 16; }if text_eq(typ,"i32") || text_eq(typ,"u32") { return 32; }return 64; }
// Exact 0.28 intrinsic semantics at one width: unsigned arithmetic in uint32_t
// (widths <= 32) or uint64_t, explicit masks, counts (uint64_t)bits&(width-1),
// arithmetic signed shr by complement, MSVC rotate intrinsics, explicit sign
// restoration. No signed overflow, negative/oversized shift or signed narrowing.
fn intrinsic_helper(op:int,name:&text,typ:&text)->text {
    let width=type_width(&typ);let signed=text_starts_with(typ,"i");let mut code=width;if !signed { code=width+100; }
    let mut unsigned_type="uint32_t";let mut mask="0xFFu";let mut sign="0x80u";
    if width==16 { mask="0xFFFFu";sign="0x8000u"; }
    if width==32 { mask="0xFFFFFFFFu";sign="0x80000000u"; }
    if width==64 { unsigned_type="uint64_t";mask="UINT64_MAX";sign="UINT64_C(0x8000000000000000)"; }
    let check=cat(["->kind!=BI||a->slot!=",int_text(code),"u)zn_fail(\"integer intrinsic requires integer operands\");"]);
    let mut parts=texts();push(parts,cat(["static __forceinline B zn_v029_",clone(name),"_",clone(typ)]));
    if op==6 { push(parts,"(B* a){a=b_resolve(a);if(!a||a"); }else { push(parts,"(B* a,B* b){a=b_resolve(a);b=b_resolve(b);if(!a||a"); }
    push(parts,clone(check));
    if op<6 { push(parts,cat(["if(!b||b->kind!=BI||b->slot!=",int_text(code),"u)zn_fail(\"integer intrinsic requires integer operands\");"])); }
    if op>=7 { push(parts,"if(!b||b->kind!=BI)zn_fail(\"integer intrinsic requires integer operands\");"); }
    push(parts,cat([clone(unsigned_type)," x=(",clone(unsigned_type),")(b_raw(a)&",clone(mask),");"]));
    if op<6 { push(parts,cat([clone(unsigned_type)," y=(",clone(unsigned_type),")(b_raw(b)&",clone(mask),");"])); }
    if op>=7 { push(parts,cat(["unsigned n=(unsigned)(b_raw(b)&",int_text(width-1),"u);"])); }
    let mut value="";
    if op==0 { value="x+y"; }if op==1 { value="x-y"; }if op==2 { value="x*y"; }if op==3 { value="x&y"; }if op==4 { value="x|y"; }if op==5 { value="x^y"; }if op==6 { value="~x"; }if op==7 { value="x<<n"; }
    if op==8 { value="x>>n";if signed { value=cat(["(x&",clone(sign),")?~((~x&",clone(mask),")>>n):x>>n"]); } }
    if op==9 || op==10 {
        let mut direction="l";if op==10 { direction="r"; }
        if width==8 { value=cat(["_rot",clone(direction),"8((unsigned char)x,(unsigned char)n)"]); }
        if width==16 { value=cat(["_rot",clone(direction),"16((unsigned short)x,(unsigned char)n)"]); }
        if width==32 { value=cat(["_rot",clone(direction),"((unsigned int)x,(int)n)"]); }
        if width==64 { value=cat(["_rot",clone(direction),"64(x,(int)n)"]); }
    }
    push(parts,cat([clone(unsigned_type)," r=(",clone(unsigned_type),")((",value,")&",clone(mask),");"]));
    if signed && width<64 { push(parts,cat(["uint64_t v=(uint64_t)r;if(r&",sign,")v|=~(uint64_t)",mask,";return b_number(v,",int_text(code),"u);}"])); }
    else { push(parts,cat(["return b_number((uint64_t)r,",int_text(code),"u);}"])); }
    return text_join(parts,"");
}
fn pow2_helper(remainder:bool)->text {
    let mut parts=texts();
    if remainder { push(parts,"static __forceinline B zn_v029_rem_pow2(B* a,uint64_t mask){"); }else { push(parts,"static __forceinline B zn_v029_div_pow2(B* a,unsigned shift){"); }
    push(parts,"a=b_resolve(a);if(!a||a->kind!=BI||a->slot!=64u)zn_fail(\"operator type mismatch\");");
    if remainder { push(parts,"return b_int((int64_t)(b_raw(a)&mask));}"); }else { push(parts,"return b_int((int64_t)(b_raw(a)>>shift));}"); }
    return text_join(parts,"");
}
// v1.2 fixed u8 arrays and big-endian wire access (contract N2). kind 0 is a
// checked read ("packet read out of bounds"), kind 1 the proven store emitted
// only when the checker's interval proof gives 0 <= offset and
// offset + width <= N for a [u8;N] owner (a fixed owner always holds exactly N
// u8 cells: zn_v120_fixed is its only constructor and no operation resizes
// it), kind 2 the checked try_write: offset < 0, offset > len or
// len - offset < width returns false with the buffer unchanged. Every helper
// still validates the boxed representation and exact value type code.
fn wire_helper(kind:int,width:int)->text {
    let bits=int_text(width*8); let code=int_text(100+width*8); let count=int_text(width); let mut parts=texts();
    if kind==0 { push(parts,cat(["static __forceinline B zn_v120_read_u",clone(bits),"_be(B* buf,B* offset){"])); }
    else if kind==1 { push(parts,cat(["static __forceinline B zn_v120_store_u",clone(bits),"_be(B* buf,B* offset,B* value){"])); }
    else { push(parts,cat(["static __forceinline B zn_v120_try_write_u",clone(bits),"_be(B* buf,B* offset,B* value){"])); }
    push(parts,"buf=b_resolve(buf);offset=b_resolve(offset);if(!buf||buf->kind!=BSEQ||!offset||offset->kind!=BI||offset->slot!=64u)zn_fail(\"wire access requires a fixed u8 array and int offset\");");
    if kind>0 { push(parts,cat(["value=b_resolve(value);if(!value||value->kind!=BI||value->slot!=",clone(code),"u)zn_fail(\"wire write value type mismatch\");"])); }
    push(parts,"int64_t at=offset->i;");
    if kind==0 {
        push(parts,cat(["uint64_t len=(uint64_t)buf->o->len;if(at<0||(uint64_t)at>len||len-(uint64_t)at<",clone(count),"u)zn_fail(\"packet read out of bounds\");"]));
        push(parts,cat(["uint64_t v=0;for(unsigned k=0;k<",clone(count),"u;++k)v=(v<<8)|(b_raw(&buf->o->data[(size_t)at+k])&0xFFu);return b_number(v,",clone(code),"u);}"]));
    } else {
        if kind==2 { push(parts,cat(["uint64_t len=(uint64_t)buf->o->len;if(at<0||(uint64_t)at>len||len-(uint64_t)at<",clone(count),"u)return b_bool(false);"])); }
        push(parts,cat(["uint64_t v=b_raw(value);for(unsigned k=0;k<",clone(count),"u;++k)buf->o->data[(size_t)at+k]=b_number((v>>(8u*(",int_text(width-1),"u-k)))&0xFFu,108u);return b_bool(true);}"]));
    }
    return text_join(parts,"");
}
fn fixed_helper()->text {
    return "static __forceinline B zn_v120_fixed(B* value,size_t count){value=b_resolve(value);if(!value||value->kind!=BI)zn_fail(\"fixed array element must be an integer\");B out=b_seq(BSEQ,count);for(size_t i=0;i<count;++i)out.o->data[i]=*value;return out;}";
}
// v1.4 OS builtins used by the anodec CLI. file_exists/list_dir/exit_code wrap
// the frozen runtime; env_var/create_dir/remove_file call Win32 through the
// bprocess.h UTF-16 conversion (paths/names that are empty, contain NUL or are
// invalid UTF-8 fail without a system call, matching LANGUAGE.md 1.3).
fn os_builtin(name:&text)->bool { return text_eq(name,"env_var") || text_eq(name,"file_exists") || text_eq(name,"create_dir") || text_eq(name,"remove_file") || text_eq(name,"list_dir") || text_eq(name,"exit_code"); }
fn os_helper(name:&text)->text {
    if text_eq(name,"file_exists") { return "static __forceinline B zn_v140_file_exists(B* path){return b_bool(zn_file_exists(b_string(path)));}"; }
    if text_eq(name,"list_dir") { return "static __forceinline B zn_v140_list_dir(B* path){return b_texts(zn_list_dir(b_string(path)));}"; }
    if text_eq(name,"exit_code") { return "static __forceinline B zn_v140_exit_code(B* code){zn_exit_code(b_integer(code));return b_unit();}"; }
    if text_eq(name,"create_dir") { return "static __forceinline B zn_v140_create_dir(B* path){zn_text p=b_string(path);wchar_t* w=p.len?zn_v120_wide(p):NULL;if(!w)return b_bool(false);int ok=CreateDirectoryW(w,NULL)!=0;if(!ok){DWORD a=GetFileAttributesW(w);ok=a!=INVALID_FILE_ATTRIBUTES&&(a&FILE_ATTRIBUTE_DIRECTORY)!=0;}free(w);return b_bool(ok!=0);}"; }
    if text_eq(name,"remove_file") { return "static __forceinline B zn_v140_remove_file(B* path){zn_text p=b_string(path);wchar_t* w=p.len?zn_v120_wide(p):NULL;if(!w)return b_bool(false);int ok=DeleteFileW(w)!=0;free(w);return b_bool(ok!=0);}"; }
    return "static B zn_v140_env_var(B* name){zn_text n=b_string(name);if(!n.len||memchr(n.data,'=',n.len))return b_literal(\"\");wchar_t* w=zn_v120_wide(n);if(!w)return b_literal(\"\");DWORD need=GetEnvironmentVariableW(w,NULL,0);if(!need||need>16777216u){free(w);return b_literal(\"\");}wchar_t* buf=(wchar_t*)calloc(need,sizeof(wchar_t));if(!buf)zn_fail(\"out of memory\");DWORD got=GetEnvironmentVariableW(w,buf,need);free(w);if(!got||got>=need){free(buf);return b_literal(\"\");}int bytes=WideCharToMultiByte(CP_UTF8,WC_ERR_INVALID_CHARS,buf,(int)got,NULL,0,NULL,NULL);if(bytes<=0){free(buf);return b_literal(\"\");}zn_text t;t.len=(size_t)bytes;t.data=(char*)zn_alloc((size_t)bytes+1);WideCharToMultiByte(CP_UTF8,WC_ERR_INVALID_CHARS,buf,(int)got,t.data,bytes,NULL,NULL);t.data[bytes]=0;free(buf);return b_text(t);}";
}
// v1.4 text builtins used by the std packages; the frozen runtime already
// implements them (zn_text_find, zn_text_replace, zn_codepoint_text).
fn text_helper(name:&text)->text {
    if text_eq(name,"text_find") { return "static __forceinline B zn_v140_text_find(B* t,B* needle,B* start){return b_int(zn_text_find(b_string(t),b_string(needle),b_integer(start)));}"; }
    if text_eq(name,"text_replace") { return "static __forceinline B zn_v140_text_replace(B* t,B* needle,B* replacement){return b_text(zn_text_replace(b_string(t),b_string(needle),b_string(replacement)));}"; }
    return "static __forceinline B zn_v140_codepoint_text(B* value){return b_text(zn_codepoint_text(b_integer(value)));}";
}
fn keys_helper()->text {
    return "static __forceinline B zn_v140_keys(B* map){map=b_resolve(map);if(!map||map->kind!=BMAP)zn_fail(\"keys requires a map\");B out=b_seq(BSEQ,0);for(size_t i=0;i<map->o->len;i+=2){B key=b_clone(&map->o->data[i]);b_push(&out,&key);}return out;}";
}
fn prefix_texts(values:&texts,end:int)->texts { let mut out=texts();for i in 0..end { push(out,text_at(values,i)); }return out; }
fn prefix_numbers(values:&ints,end:int)->ints { let mut out=[];for i in 0..end { push(out,at(values,i)); }return out; }
fn cat(parts:texts)->text { return text_join(parts,""); }
fn line(state:&mut State,parts:texts) { push(state.lines,cat(parts)); }
fn fail(state:&mut State,pos:int,message:text) {
    if len(state.error)==0 { state.error=message;state.error_at=pos; }
}
fn fresh(state:&mut State,prefix:text)->text { let value=concat(prefix,int_text(state.next));state.next=state.next+1;return value; }
fn temp(state:&mut State,value:text)->text {
    let name=fresh(&mut state,"t");line(&mut state,["B ",clone(name),"=",value,";"]);push(state.temps,clone(name));return concat("&",name);
}
fn drop_temps(state:&mut State,start:int) {
    let mut i=len(state.temps);
    while i>start { i=i-1;let name=text_at(state.temps,i);line(&mut state,["b_drop(&",name,");"]); }
    state.temps=prefix_texts(&state.temps,start);
}
fn drop_owners(state:&mut State,start:int) {
    let mut i=len(state.owns);
    while i>start { i=i-1;let name=text_at(state.owns,i);line(&mut state,["b_drop(&",name,");"]); }
}
fn close_owners(state:&mut State,start:int) {
    drop_owners(&mut state,start);state.owns=prefix_texts(&state.owns,start);
}
fn canonical(program:&crate::ast::Program,module:&text,raw:&text)->text {
    let typ=crate::ast::base(&raw);
    if text_eq(typ,"i64") { return "int"; }
    if crate::ast::is_span(&typ) { let owner=crate::ast::span_owner(&typ); return concat("[",concat(crate::ast::resolve(&program,&module,&owner),"]")); }
    if crate::ast::is_id(&typ) { let owner=crate::ast::id_owner(&typ); return concat("id(",concat(crate::ast::resolve(&program,&module,&owner),")")); }
    if crate::ast::is_fixed(&typ) { return crate::ast::canonical_fixed(&typ); }
    if crate::ast::primitive(&typ) || crate::ast::builtin_type(&typ) { return typ; }
    return crate::ast::resolve(&program,&module,&typ);
}
fn inferred(report:&crate::checker::Report,unit:int,index:int)->text {
    let key=crate::ast::node_key(unit,index);if contains_key(report.types,key) { return clone_get(report.types,key); }return "?";
}
fn field_index(program:&crate::ast::Program,report:&crate::checker::Report,typ:&text,name:&text)->int {
