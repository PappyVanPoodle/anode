fn place(program:&crate::ast::Program,report:&crate::checker::Report,state:&mut State,unit:int,index:int,depth:int)->text {
    if depth>96 { fail(&mut state,0,"codegen place depth exceeds 96");return "NULL"; }
    borrow ast_unit_6=at(program.units,unit) { borrow node=at(ast_unit_6.tree.nodes,index) {
    if node.kind==30 && contains_key(state.names,node.name) { return clone_get(state.names,node.name); }
    if node.kind==38 && text_starts_with(node.name,"&") { return place(&program,&report,&mut state,unit,at(node.children,0),depth+1); }
