fn headers(program:&crate::ast::Program,report:&mut Report) {
    for unit in 0..len(program.units) {
        borrow source=at(program.units,unit) {
            if len(source.tree.error)>0 { continue; }
            for i in 0..len(source.tree.roots) {
                let index=at(source.tree.roots,i); borrow ast_unit_36=at(program.units,unit) { borrow node=at(ast_unit_36.tree.nodes,index) {
                if node.kind==1 {
                    let mut found=false;
                    let required=crate::ast::sibling(&source.name,&node.name);
                    for other in &program.units { if text_eq(other.name,required) { found=true; } }
                    if !found { let message=concat("missing module ",node.name);diagnostic(&program,&mut report,unit,index,message); }
                }
                if (node.kind>=2 && node.kind<=6) || node.kind==25 {
                    let mut names=Marks(); let mut count=len(node.children); if node.kind==6 { count=count-1; }
                    for j in 0..count {
                        let field_index=at(node.children,j); borrow ast_unit_37=at(program.units,unit) { borrow field=at(ast_unit_37.tree.nodes,field_index) {
                        if contains_key(names,field.name) { let message=concat("duplicate member/parameter ",field.name);diagnostic(&program,&mut report,unit,field_index,message); }
                        insert(names,clone(field.name),1);
                        let stored=node.kind!=6 && !(node.kind==3 && text_eq(field.typ,"unit"));
                        let typ=validate_type(&program,&mut report,unit,field_index,&field.typ,stored);
                        insert(report.types,crate::ast::node_key(unit,field_index),typ);
                    } } }
                    if node.kind==6 {
                        let typ=validate_type(&program,&mut report,unit,index,&node.typ,false);
                        if text_starts_with(typ,"&") || text_eq(typ,"str") { diagnostic(&program,&mut report,unit,index,"borrowed returns are outside the subset"); }
                        insert(report.types,crate::ast::node_key(unit,index),typ);
                        if contains(node.name,"::") {
                            let parts=split(node.name,"::");
                            if len(parts)!=2 || count==0 { diagnostic(&program,&mut report,unit,index,"impl requires a local owner and typed self receiver"); }
                            else {
                                let owner=text_at(parts,0); borrow ast_unit_38=at(program.units,unit) { borrow receiver=at(ast_unit_38.tree.nodes,at(node.children,0)) { let received=crate::ast::base(&receiver.typ);
                                if !text_eq(receiver.name,"self") || !text_eq(received,owner) { diagnostic(&program,&mut report,unit,index,"method first parameter must be self:Self, self:&Self or self:&mut Self"); }
                            } } }
                        }
                    } else {
                        let module=crate::ast::module_name(&program,unit); let typ=crate::ast::resolve(&program,&module,&node.name); let trail="";
                        check_cycle(&program,&mut report,unit,index,&typ,&trail,0);
                        if node.kind==4 && node.flag>=2 {
                            let elem=element(&program,&report,&typ,0);
                            if !contains_key(report.symbols,elem) { diagnostic(&program,&mut report,unit,index,"SoA element must be a nonempty record"); }
                            else { let symbol=clone_get(report.symbols,elem); borrow ast_unit_39=at(program.units,symbol.unit) { borrow record=at(ast_unit_39.tree.nodes,symbol.node) { if record.kind!=2 || len(record.children)==0 { diagnostic(&program,&mut report,unit,index,"SoA element must be a nonempty record"); } } } }
                        }
                        if node.kind==5 {
                            let key_type=element(&program,&report,&typ,0);
                            if !crate::ast::is_id(&key_type) && !text_eq(key_type,"text") && (!crate::ast::primitive(&key_type) || text_eq(key_type,"bool") || text_eq(key_type,"str") || text_eq(key_type,"f64") || text_eq(key_type,"f32") || text_eq(key_type,"ints") || text_eq(key_type,"texts") || text_eq(key_type,"unit")) {
                                diagnostic(&program,&mut report,unit,index,"map key must be text or integer");
                            }
                        }
                    }
                }
            } } }
        }
    }
}
pub fn check(program:&crate::ast::Program)->Report {
    let mut report=Report{symbols:Symbols(),types:Types(),diagnostics:texts(),resolved:0,moves:0,functions:0,nonnegative:Marks(),lows:Marks(),highs:Marks(),effects:Marks(),callers:texts(),callees:texts(),current:""};
    collect(&program,&mut report); headers(&program,&mut report);
    if len(report.diagnostics)>0 { return report; }
    for unit in 0..len(program.units) {
        let module=crate::ast::module_name(&program,unit);
        borrow source=at(program.units,unit) {
            for i in 0..len(source.tree.roots) {
                let index=at(source.tree.roots,i); borrow ast_unit_40=at(program.units,unit) { borrow node=at(ast_unit_40.tree.nodes,index) {
                if node.kind!=6 { continue; }
                let return_type=normal(&program,&module,&node.typ); let mut state=empty_state(clone(return_type));
                report.current=crate::ast::resolve(&program,&module,&node.name);
                for j in 0..len(node.children)-1 {
                    let parameter_index=at(node.children,j); borrow ast_unit_41=at(program.units,unit) { borrow parameter=at(ast_unit_41.tree.nodes,parameter_index) { let typ=normal(&program,&module,&parameter.typ);
                    let binding=clone(parameter.name);let mutable=parameter.flag==1;bind(&program,&mut report,&mut state,unit,parameter_index,binding,typ,mutable);
                } } }
                let body=at(node.children,len(node.children)-1); check_statement(&program,&mut report,&mut state,unit,body,0);
                if !text_eq(return_type,"unit") && !state.exited { diagnostic(&program,&mut report,unit,index,"function may reach end without return"); }
                report.functions=report.functions+1; report.current="";
            } } }
        }
    }
    if len(report.diagnostics)==0 { validate_effects(&program,&mut report); }
    return report;
}
fn flag(marks:&Marks,key:&text)->int { if contains_key(marks,key) { return clone_get(marks,key); } return 0; }
// v1.2 @effect(no_alloc, no_io, bounded), checked after every body like the
// Rust effects::validate: allocation/I/O propagate over the user call graph to
// a fixed point; bounded is proven bottom-up from functions without while or
// waiting builtins whose every user callee is proven and publishes bounded, so
// direct and mutual recursion never acquire the proof. The first violated
// effect (function order, then declared effect order) is reported.
fn validate_effects(program:&crate::ast::Program,report:&mut Report) {
    let mut declared=Contracts(); let mut masks=Marks(); let mut keys=texts(); let mut units=[]; let mut nodes=[];
    for unit in 0..len(program.units) {
        let module=crate::ast::module_name(&program,unit);
        borrow source=at(program.units,unit) {
            for i in 0..len(source.tree.roots) {
                let index=at(source.tree.roots,i); borrow ast_unit_47=at(program.units,unit) { borrow node=at(ast_unit_47.tree.nodes,index) {
                if node.kind==6 { push(keys,crate::ast::resolve(&program,&module,&node.name)); push(units,unit); push(nodes,index); }
                if node.kind==26 && len(node.children)==1 {
                    borrow ast_unit_48=at(program.units,unit) { borrow target=at(ast_unit_48.tree.nodes,at(node.children,0)) {
                    let key=crate::ast::resolve(&program,&module,&target.name); insert(declared,clone(key),clone(node.name)); insert(masks,key,node.flag);
                    } }
                }
            } } }
        }
    }
    if len(declared)==0 { return; }
    let mut summary=clone(report.effects); let mut changed=true;
    while changed {
        changed=false;
        for i in 0..len(report.callers) {
            let caller=text_at(report.callers,i); let callee=text_at(report.callees,i);
            let old=flag(&summary,&caller); let merged=bit_or(old,bit_and(flag(&summary,&callee),3));
            if merged!=old { insert(summary,caller,merged); changed=true; }
        }
    }
    let mut proven=Marks(); changed=true;
    while changed {
        changed=false;
        for i in 0..len(keys) {
            let key=text_at(keys,i);
            if contains_key(proven,key) || bit_and(flag(&report.effects,&key),12)!=0 { continue; }
            let mut finite=true;
            for j in 0..len(report.callers) {
                let caller=text_at(report.callers,j);
                if text_eq(caller,key) { let callee=text_at(report.callees,j); if !contains_key(proven,callee) || bit_and(flag(&masks,&callee),4)==0 { finite=false; } }
            }
            if finite { insert(proven,key,1); changed=true; }
        }
    }
    for i in 0..len(keys) {
        let key=text_at(keys,i);
        if !contains_key(declared,key) { continue; }
        let effects=split(clone_get(declared,key),",");
        for j in 0..len(effects) {
            let effect=text_at(effects,j); let bits=flag(&summary,&key);
            let violated=(text_eq(effect,"no_alloc") && bit_and(bits,1)!=0) || (text_eq(effect,"no_io") && bit_and(bits,2)!=0) || (text_eq(effect,"bounded") && !contains_key(proven,key));
            if violated {
