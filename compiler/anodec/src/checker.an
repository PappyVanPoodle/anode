                borrow ast_unit_49=at(program.units,unit) { borrow node=at(ast_unit_49.tree.nodes,index) { name=clone(node.name); } }
                diagnostic(&program,&mut report,unit,index,concat("effect contract ",concat(effect,concat(" violated in ",concat(name," (including transitive calls)")))));
