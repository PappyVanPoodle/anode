pub struct Symbol { kind:int, unit:int, node:int, typ:text }
pub map Symbols(text,Symbol);
pub map Types(text,text);
// nonnegative: name-use nodes proven >= 0 (immutable int bindings whose
// initializer, or range-loop start, is proven non-negative). C lowering uses it.
// v1.2: lows/highs are proven int intervals of name-use nodes (C lowering of
// fixed-array wire stores); effects/callers/callees/current record each
// function's local effects and user call edges for the @effect pass.
pub struct Report { symbols:Symbols, types:Types, diagnostics:texts, resolved:int, moves:int, functions:int, nonnegative:Marks, lows:Marks, highs:Marks, effects:Marks, callers:texts, callees:texts, current:text }
struct Local { typ:text, mutable:bool }
map Locals(text,Local);
pub map Marks(text,int);
map Contracts(text,text);
struct Loan { path:text, exclusive:bool }
vector Loans(Loan);
struct State { locals:Locals, names:texts, dead:Marks, moved_names:texts, loans:Loans, return_type:text, loop_depth:int, exited:bool, aliasing:bool, nonneg:Marks, lows:Marks, highs:Marks }

fn empty_state(return_type:text)->State {
    return State{locals:Locals(),names:texts(),dead:Marks(),moved_names:texts(),loans:Loans(),return_type:return_type,loop_depth:0,exited:false,aliasing:false,nonneg:Marks(),lows:Marks(),highs:Marks()};
}
// Local effect bits: 1 may allocate, 2 performs I/O, 4 contains while, 8 may wait.
fn note_effect(report:&mut Report,bits:int) {
    if len(report.current)==0 || bits==0 { return; }
    let mut old=0; if contains_key(report.effects,report.current) { old=clone_get(report.effects,report.current); }
    let key=clone(report.current); let merged=bit_or(old,bits); insert(report.effects,key,merged);
}
fn note_call(report:&mut Report,callee:&text) {
    if len(report.current)==0 { return; }
    let caller=clone(report.current); push(report.callers,caller); push(report.callees,clone(callee));
}
fn diagnostic(program:&crate::ast::Program,report:&mut Report,unit:int,index:int,message:text) {
    let path=crate::ast::path(&program,unit); borrow ast_unit_1=at(program.units,unit) { borrow node=at(ast_unit_1.tree.nodes,index) {
    push(report.diagnostics,concat(path,concat(":byte ",concat(int_text(node.pos),concat(": ",message)))));
} } }
fn normal(program:&crate::ast::Program,module:&text,raw:&text)->text {
    let name=crate::ast::base(&raw); let mut prefix="";
    if text_starts_with(raw,"&mut ") { prefix="&mut "; }
    else if text_starts_with(raw,"&") { prefix="&"; }
    let mut value=clone(name);
    if text_eq(value,"i64") { value="int"; }
    if crate::ast::is_span(&value) { let owner=crate::ast::span_owner(&value); return concat(prefix,concat("[",concat(crate::ast::resolve(&program,&module,&owner),"]"))); }
    if crate::ast::is_id(&value) { let owner=crate::ast::id_owner(&value); let canonical=crate::ast::resolve(&program,&module,&owner); return concat(prefix,concat("id(",concat(canonical,")"))); }
    if crate::ast::is_fixed(&value) { return concat(prefix,crate::ast::canonical_fixed(&value)); }
    if !crate::ast::primitive(&value) && !crate::ast::builtin_type(&value) { value=crate::ast::resolve(&program,&module,&value); }
    return concat(prefix,value);
}
// v1.2 fixed arrays follow the language limits: integer elements, 1..65536
// elements and at most 64 KiB of inline storage.
fn fixed_problem(element:&text,count:int)->text {
    if !integer_type(&element) { return "fixed array element must be an integer type"; }
    let mut width=8; if text_eq(element,"i16") || text_eq(element,"u16") { width=16; } if text_eq(element,"i32") || text_eq(element,"u32") { width=32; } if text_eq(element,"int") || text_eq(element,"i64") || text_eq(element,"u64") { width=64; }
    if count<1 || count>65536 || count*(width/8)>65536 { return "fixed array length must be 1..65536 with at most 64 KiB of storage"; }
    return "";
}
fn validate_type(program:&crate::ast::Program,report:&mut Report,unit:int,index:int,raw:&text,stored:bool)->text {
    let module=crate::ast::module_name(&program,unit); let typ=normal(&program,&module,&raw); let base=crate::ast::base(&typ);
    if crate::ast::is_span(&base) {
        let owner=crate::ast::span_owner(&base);
        if !text_starts_with(typ,"&") || stored { diagnostic(&program,&mut report,unit,index,"vector spans are borrowed-only nonowning parameters"); }
        if !contains_key(report.symbols,owner) { diagnostic(&program,&mut report,unit,index,"span requires nominal contiguous vector"); }
        else { let symbol=clone_get(report.symbols,owner); borrow ast_unit_2=at(program.units,symbol.unit) { borrow declaration=at(ast_unit_2.tree.nodes,symbol.node) { if symbol.kind!=4 || declaration.flag>=2 { diagnostic(&program,&mut report,unit,index,"span requires nominal contiguous vector; SoA rows are noncontiguous"); } } } }
        return typ;
    }
    if crate::ast::is_id(&base) {
        let owner=crate::ast::id_owner(&base);
        if !contains_key(report.symbols,owner) { diagnostic(&program,&mut report,unit,index,"id requires a declared arena"); }
        else { let symbol=clone_get(report.symbols,owner); if symbol.kind!=25 { diagnostic(&program,&mut report,unit,index,"id requires a nominal arena"); } }
        return typ;
    }
    if crate::ast::is_fixed(&base) {
        let element=crate::ast::fixed_element(&base); let problem=fixed_problem(&element,crate::ast::fixed_length(&base));
        if len(problem)>0 { diagnostic(&program,&mut report,unit,index,problem); }
        return typ;
    }
    if !crate::ast::primitive(&base) && !crate::ast::builtin_type(&base) {
        if !contains_key(report.symbols,base) { diagnostic(&program,&mut report,unit,index,concat("unknown type ",base)); }
        else { let symbol=clone_get(report.symbols,base);
            if (symbol.kind<2 || symbol.kind>5) && symbol.kind!=25 { diagnostic(&program,&mut report,unit,index,"type name denotes a function/variant"); }
        }
    }
    if text_eq(typ,"&mut str") { diagnostic(&program,&mut report,unit,index,"mutable str is unsupported"); }
    if stored && (text_starts_with(typ,"&") || text_eq(typ,"str") || text_eq(typ,"unit")) {
        diagnostic(&program,&mut report,unit,index,"stored fields/elements require a finite owned or scalar type");
    }
    return typ;
}
fn put_symbol(program:&crate::ast::Program,report:&mut Report,key:text,symbol:Symbol) {
    if contains_key(report.symbols,key) { diagnostic(&program,&mut report,symbol.unit,symbol.node,concat("duplicate declaration ",key)); }
    else { insert(report.symbols,key,symbol); }
}
fn collect(program:&crate::ast::Program,report:&mut Report) {
    let mut modules=Marks();
    for unit in 0..len(program.units) {
        let module=crate::ast::module_name(&program,unit);
        if contains_key(modules,module) { push(report.diagnostics,concat("duplicate module ",module)); }
        insert(modules,clone(module),1);
        borrow source=at(program.units,unit) {
            if len(source.tree.error)>0 { push(report.diagnostics,concat(source.path,concat(": parse: ",source.tree.error))); continue; }
            for i in 0..len(source.tree.roots) {
                let index=at(source.tree.roots,i); borrow ast_unit_3=at(program.units,unit) { borrow node=at(ast_unit_3.tree.nodes,index) {
                if (node.kind>=2 && node.kind<=6) || node.kind==25 {
                    let key=crate::ast::resolve(&program,&module,&node.name);
                    let declaration=Symbol{kind:node.kind,unit:unit,node:index,typ:clone(node.typ)};
                    put_symbol(&program,&mut report,clone(key),declaration);
                    if node.kind==3 {
                        for j in 0..len(node.children) {
                            let member_index=at(node.children,j); borrow ast_unit_4=at(program.units,unit) { borrow member=at(ast_unit_4.tree.nodes,member_index) {
                            let variant=crate::ast::key(&key,&member.name);
                            put_symbol(&program,&mut report,variant,Symbol{kind:9,unit:unit,node:member_index,typ:clone(key)});
                        } } }
                    }
                }
            } } }
        }
    }
}
fn member(program:&crate::ast::Program,report:&Report,typ:&text,name:&text)->text {
    if text_eq(typ,"ProcessOutput") {
        if text_eq(name,"status") { return "int"; }
        if text_eq(name,"stdout") || text_eq(name,"stderr") { return "text"; }
        return "?";
    }
    if !contains_key(report.symbols,typ) { return "?"; }
    let symbol=clone_get(report.symbols,typ); borrow ast_unit_5=at(program.units,symbol.unit) { borrow node=at(ast_unit_5.tree.nodes,symbol.node) {
    let module=crate::ast::module_name(&program,symbol.unit);
    for i in 0..len(node.children) {
        borrow ast_unit_6=at(program.units,symbol.unit) { borrow field=at(ast_unit_6.tree.nodes,at(node.children,i)) {
        if text_eq(field.name,name) { return normal(&program,&module,&field.typ); }
    } } }
    return "?";
} } }
fn element(program:&crate::ast::Program,report:&Report,typ:&text,which:int)->text {
    let base=crate::ast::collection(&typ);
    if text_eq(base,"ints") { return "int"; }
    if text_eq(base,"texts") { return "text"; }
    if crate::ast::is_fixed(&base) { if which==0 { return crate::ast::fixed_element(&base); } return "?"; }
    if !contains_key(report.symbols,base) { return "?"; }
    let symbol=clone_get(report.symbols,base); borrow ast_unit_7=at(program.units,symbol.unit) { borrow node=at(ast_unit_7.tree.nodes,symbol.node) {
    if (node.kind!=4 && node.kind!=5 && node.kind!=25) || which>=len(node.children) { return "?"; }
    borrow ast_unit_8=at(program.units,symbol.unit) { borrow field=at(ast_unit_8.tree.nodes,at(node.children,which)) {
    let module=crate::ast::module_name(&program,symbol.unit); return normal(&program,&module,&field.typ);
} } } } }
fn is_arena(report:&Report,typ:&text)->bool {
    let base=crate::ast::base(&typ); if !contains_key(report.symbols,base) { return false; }
    borrow symbol=get(report.symbols,base) { return symbol.kind==25; }
}
fn result_payload(program:&crate::ast::Program,report:&Report,typ:&text,which:int)->text {
    if text_eq(typ,"ReadResult") { return "text"; }
    if text_eq(typ,"ProcessRun") { if which==0 { return "ProcessOutput"; } return "text"; }
    if !contains_key(report.symbols,typ) { return "?"; }
    let symbol=clone_get(report.symbols,typ); borrow ast_unit_9=at(program.units,symbol.unit) { borrow declaration=at(ast_unit_9.tree.nodes,symbol.node) {
    if declaration.kind!=3 || len(declaration.children)!=2 { return "?"; }
    borrow ast_unit_10=at(program.units,symbol.unit) { borrow field=at(ast_unit_10.tree.nodes,at(declaration.children,which)) { let module=crate::ast::module_name(&program,symbol.unit);
    return normal(&program,&module,&field.typ);
} } } } }
fn is_map(report:&Report,typ:&text)->bool {
    let base=crate::ast::base(&typ); if !contains_key(report.symbols,base) { return false; }
    borrow symbol=get(report.symbols,base) { return symbol.kind==5; }
}
fn is_vector(report:&Report,typ:&text)->bool {
    let base=crate::ast::collection(&typ); if !contains_key(report.symbols,base) { return false; }
    borrow symbol=get(report.symbols,base) { return symbol.kind==4; }
}
fn is_soa(program:&crate::ast::Program,report:&Report,typ:&text)->bool {
    let base=crate::ast::collection(&typ); if !contains_key(report.symbols,base) { return false; }
    let symbol=clone_get(report.symbols,base); borrow ast_unit_11=at(program.units,symbol.unit) { borrow node=at(ast_unit_11.tree.nodes,symbol.node) { return symbol.kind==4 && node.flag>=2;
} } }
fn place(program:&crate::ast::Program,unit:int,index:int,depth:int)->text {
    if depth>96 || index<0 { return ""; }
    borrow ast_unit_12=at(program.units,unit) { borrow node=at(ast_unit_12.tree.nodes,index) {
    if node.kind==30 { return clone(node.name); }
    if node.kind==38 && text_starts_with(node.name,"&") { return place(&program,unit,at(node.children,0),depth+1); }
    if node.kind==36 {
        let root=place(&program,unit,at(node.children,0),depth+1);
        if len(root)>0 { return concat(root,concat(".",node.name)); }
    }
    return "";
} } }
fn root_name(path:&text)->text {
    for i in 0..len(path) { if byte_at(path,i)==46 { return slice(path,0,i); } }
    return clone(path);
}
fn place_type(program:&crate::ast::Program,report:&Report,state:&State,unit:int,index:int,depth:int)->text {
    if depth>96 { return "?"; }
    borrow ast_unit_13=at(program.units,unit) { borrow node=at(ast_unit_13.tree.nodes,index) {
    if node.kind==30 {
        if !contains_key(state.locals,node.name) { return "?"; }
        borrow local=get(state.locals,node.name) { return crate::ast::base(&local.typ); }
    }
    if node.kind==36 {
        let owner=place_type(&program,&report,&state,unit,at(node.children,0),depth+1);
        return member(&program,&report,&owner,&node.name);
    }
    return "?";
} } }
fn overlaps(left:&text,right:&text)->bool {
    return text_eq(left,right) || text_starts_with(left,concat(right,".")) || text_starts_with(right,concat(left,"."));
}
fn check_live(program:&crate::ast::Program,report:&mut Report,state:&State,unit:int,index:int,path:&text,consuming:bool) {
    for i in 0..len(state.moved_names) {
        let moved=text_at(state.moved_names,i);
        if contains_key(state.dead,moved) && overlaps(&moved,&path) {
            diagnostic(&program,&mut report,unit,index,concat("use after move: ",path)); return;
        }
    }
    for loan in &state.loans {
        if overlaps(&loan.path,&path) && (loan.exclusive || consuming) {
            diagnostic(&program,&mut report,unit,index,concat("owner accessed while scoped loan is active: ",path)); return;
        }
    }
}
fn consume_place(program:&crate::ast::Program,report:&mut Report,state:&mut State,unit:int,index:int,path:&text,typ:&text) {
    if !crate::ast::owned(&typ) { return; }
    let root=root_name(&path);
    if contains_key(state.locals,root) {
        let local=clone_get(state.locals,root);
        if text_starts_with(local.typ,"&") {
            diagnostic(&program,&mut report,unit,index,concat("cannot move borrowed owner: ",path)); return;
        }
    }
    if !contains_key(state.dead,path) { insert(state.dead,clone(path),1); push(state.moved_names,clone(path)); report.moves=report.moves+1; }
}
fn restore(state:&mut State,path:&text) {
    for i in 0..len(state.moved_names) {
        let moved=text_at(state.moved_names,i);
        if text_eq(moved,path) || text_starts_with(moved,concat(path,".")) { let removed=remove(state.dead,moved); }
    }
}
fn mutable_place(program:&crate::ast::Program,report:&mut Report,state:&State,unit:int,index:int) {
    borrow ast_unit_14=at(program.units,unit) { borrow expression=at(ast_unit_14.tree.nodes,index) {
    if expression.kind==38 && text_eq(expression.name,"&") { diagnostic(&program,&mut report,unit,index,"mutation through shared borrow argument"); return; }
    let path=place(&program,unit,index,0); let root=root_name(&path);
    if len(path)==0 || !contains_key(state.locals,root) { diagnostic(&program,&mut report,unit,index,"mutation requires a named place"); return; }
    let local=clone_get(state.locals,root);
    for i in 0..len(state.moved_names) {
        let moved=text_at(state.moved_names,i);
        if contains_key(state.dead,moved) && text_starts_with(path,concat(moved,".")) {
            diagnostic(&program,&mut report,unit,index,concat("mutation below moved owner: ",path)); return;
        }
    }
    for loan in &state.loans {
        if overlaps(&loan.path,&path) { diagnostic(&program,&mut report,unit,index,concat("mutation while scoped loan is active: ",path)); return; }
    }
    if text_starts_with(local.typ,"&") {
        if !text_starts_with(local.typ,"&mut ") { diagnostic(&program,&mut report,unit,index,"mutation through shared borrow"); }
    } else if !local.mutable { diagnostic(&program,&mut report,unit,index,concat("immutable binding: ",root)); }
} } }
fn bind(program:&crate::ast::Program,report:&mut Report,state:&mut State,unit:int,index:int,name:text,typ:text,mutable:bool) {
    if contains_key(state.locals,name) { diagnostic(&program,&mut report,unit,index,concat("duplicate local ",name)); return; }
    if contains_key(state.nonneg,name) { let cleared=remove(state.nonneg,name); }
    if contains_key(state.lows,name) { let low=remove(state.lows,name); let high=remove(state.highs,name); }
    push(state.names,clone(name)); insert(state.locals,name,Local{typ:typ,mutable:mutable});
}
fn same(program:&crate::ast::Program,report:&mut Report,unit:int,index:int,actual:&text,expected:&text) {
    if (text_eq(actual,"int") && text_eq(expected,"i64")) || (text_eq(actual,"i64") && text_eq(expected,"int")) { return; }
    if !text_eq(actual,expected) && !text_eq(actual,"?") && !text_eq(expected,"?") {
        diagnostic(&program,&mut report,unit,index,concat("type mismatch: expected ",concat(expected,concat(", got ",actual))));
    }
}
fn textlike(typ:&text)->bool { return text_eq(typ,"text") || text_eq(typ,"str"); }
// Source remains seed-0.27 compatible: classify names without invoking them.
pub fn integer_type(typ:&text)->bool { return text_eq(typ,"int") || text_eq(typ,"i64") || text_eq(typ,"i8") || text_eq(typ,"i16") || text_eq(typ,"i32") || text_eq(typ,"u8") || text_eq(typ,"u16") || text_eq(typ,"u32") || text_eq(typ,"u64"); }
pub fn integer_intrinsic(name:&text)->int {
    if text_eq(name,"wrapping_add") {return 0;} if text_eq(name,"wrapping_sub") {return 1;} if text_eq(name,"wrapping_mul") {return 2;}
    if text_eq(name,"bit_and") {return 3;} if text_eq(name,"bit_or") {return 4;} if text_eq(name,"bit_xor") {return 5;} if text_eq(name,"bit_not") {return 6;}
    if text_eq(name,"shl") {return 7;} if text_eq(name,"shr") {return 8;} if text_eq(name,"rotl") {return 9;} if text_eq(name,"rotr") {return 10;} return -1;
}
// v0.29 finite non-negativity proof for C lowering of int (i64) `%`/`/` by a
// power-of-two literal. Sound because ordinary int `+`/`*` are checked (overflow
// faults instead of wrapping), len/char_count/byte_at results are >= 0, a
// positive-literal divisor keeps a non-negative dividend non-negative, and
// facts for names come only from immutable bindings (see check_statement).
// Anything else, including narrow types and field reads, stays unproven.
@effect(no_alloc, no_io, bounded)
pub fn decimal_literal(name:&text)->bool {
    if len(name)==0 { return false; }
    for i in 0..len(name) { let c=byte_at(name,i); if c<48 || c>57 { return false; } }
    return true;
}
@effect(no_alloc, no_io, bounded)
fn positive_literal(name:&text)->bool {
    if !decimal_literal(&name) { return false; }
    for i in 0..len(name) { if byte_at(name,i)!=48 { return true; } }
    return false;
}
pub fn power_of_two_literal(program:&crate::ast::Program,unit:int,index:int)->int {
    borrow ast_unit_42=at(program.units,unit) { borrow node=at(ast_unit_42.tree.nodes,index) {
    if node.kind!=31 || !decimal_literal(&node.name) { return -1; }
    let mut value=1;
    for shift in 0..63 { if text_eq(int_text(value),node.name) { return shift; } if shift<62 { value=value*2; } }
    return -1;
} } }
pub fn proven_nonnegative(program:&crate::ast::Program,report:&Report,unit:int,index:int,depth:int)->bool {
    if depth>96 { return false; }
    let key=crate::ast::node_key(unit,index);
    if !contains_key(report.types,key) { return false; }
    let typ=clone_get(report.types,key);
    if !text_eq(typ,"int") && !text_eq(typ,"i64") { return false; }
    borrow ast_unit_43=at(program.units,unit) { borrow node=at(ast_unit_43.tree.nodes,index) {
    if node.kind==31 { return decimal_literal(&node.name); }
    if node.kind==30 { return contains_key(report.nonnegative,key); }
    if node.kind==39 {
        if text_eq(node.name,"+") || text_eq(node.name,"*") { return proven_nonnegative(&program,&report,unit,at(node.children,0),depth+1) && proven_nonnegative(&program,&report,unit,at(node.children,1),depth+1); }
        if text_eq(node.name,"%") || text_eq(node.name,"/") {
            borrow ast_unit_44=at(program.units,unit) { borrow divisor=at(ast_unit_44.tree.nodes,at(node.children,1)) {
            let positive=divisor.kind==31 && positive_literal(&divisor.name);
            return positive && proven_nonnegative(&program,&report,unit,at(node.children,0),depth+1);
            } }
        }
        return false;
    }
    if node.kind==35 {
        borrow ast_unit_45=at(program.units,unit) { borrow callee=at(ast_unit_45.tree.nodes,at(node.children,0)) {
        if callee.kind!=30 { return false; }
        let module=crate::ast::module_name(&program,unit);let resolved=crate::ast::resolve(&program,&module,&callee.name);
        if contains_key(report.symbols,resolved) { return false; }
        return text_eq(callee.name,"len") || text_eq(callee.name,"char_count") || text_eq(callee.name,"byte_at");
        } }
    }
    return false;
} } }
// v1.2 finite interval proof for int expressions, used only to lower a fixed
// u8 array big-endian store without its bounds check. Sound for the same
// reasons as proven_nonnegative: ordinary int +,-,* are checked (an overflow
// faults before the value reaches a store), facts come only from immutable
// bindings and range-loop cursors (never assigned), and every endpoint stays
// within +/-2^31 so this computation itself cannot overflow. Anything else,
// including field reads, calls, division and narrow types, is unproven ([]).
pub fn proven_range(program:&crate::ast::Program,report:&Report,unit:int,index:int,depth:int)->ints {
    if depth>96 { return []; }
    let key=crate::ast::node_key(unit,index);
    if !contains_key(report.types,key) { return []; }
    let typ=clone_get(report.types,key);
    if !text_eq(typ,"int") && !text_eq(typ,"i64") { return []; }
    borrow ast_unit_46=at(program.units,unit) { borrow node=at(ast_unit_46.tree.nodes,index) {
    if node.kind==31 {
        if !decimal_literal(&node.name) || len(node.name)>10 { return []; }
        let value=parse_int(node.name); if value>2147483648 { return []; }
        return [value,value];
    }
    if node.kind==30 {
        if contains_key(report.lows,key) && contains_key(report.highs,key) { let low=clone_get(report.lows,key); let high=clone_get(report.highs,key); return [low,high]; }
        return [];
    }
    if node.kind==39 && (text_eq(node.name,"+") || text_eq(node.name,"-") || text_eq(node.name,"*")) {
        let left=proven_range(&program,&report,unit,at(node.children,0),depth+1); let right=proven_range(&program,&report,unit,at(node.children,1),depth+1);
        if len(left)!=2 || len(right)!=2 { return []; }
        let a=at(left,0); let b=at(left,1); let c=at(right,0); let d=at(right,1);
        let mut low=a+c; let mut high=b+d;
        if text_eq(node.name,"-") { low=a-d; high=b-c; }
        if text_eq(node.name,"*") {
            low=a*c; high=a*c;
            let corners=[a*d,b*c,b*d];
            for i in 0..3 { let corner=at(corners,i); if corner<low { low=corner; } if corner>high { high=corner; } }
        }
        if low< -2147483648 || high>2147483648 { return []; }
        return [low,high];
    }
    return [];
} } }
// v1.2 wire builtins: wire_ aliases canonicalize like the Rust checker.
pub fn wire_name(name:&text)->text {
    if text_starts_with(name,"wire_") {
        let rest=slice(name,5,len(name));
        if wire_width(&rest)>0 { return rest; }
    }
    return clone(name);
