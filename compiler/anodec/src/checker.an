    if text_eq(name,"text_join") { expect_arg(&program,&mut report,unit,index,&types,0,"texts"); expect_arg(&program,&mut report,unit,index,&types,1,"textlike"); }
    if text_eq(name,"text_at") { expect_arg(&program,&mut report,unit,index,&types,0,"texts"); expect_arg(&program,&mut report,unit,index,&types,1,"int"); }
