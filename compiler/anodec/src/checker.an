        || text_eq(name,"text_eq") || text_eq(name,"contains") || text_eq(name,"text_starts_with") || text_eq(name,"text_ends_with")
        || text_eq(name,"concat") || text_eq(name,"slice") || text_eq(name,"text_trim") || text_eq(name,"text_find") || text_eq(name,"text_replace") || text_eq(name,"codepoint_text") || text_eq(name,"to_text") || text_eq(name,"text_lines") || text_eq(name,"split") || text_eq(name,"text_join")
        || integer_intrinsic(&name)>=0 || text_eq(name,"is_int") || text_eq(name,"parse_int") || text_eq(name,"is_f64") || text_eq(name,"parse_f64") || text_eq(name,"int_text") || numeric(&name) || wire_read(&name);
