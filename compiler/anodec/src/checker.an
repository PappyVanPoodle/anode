        || text_eq(name,"text_eq") || text_eq(name,"contains") || text_eq(name,"text_starts_with") || text_eq(name,"text_ends_with") || text_eq(name,"is_int") || text_eq(name,"parse_int")
        || text_eq(name,"contains_key") || text_eq(name,"remove") || text_eq(name,"contains_id") || text_eq(name,"free") || text_eq(name,"args_count")
