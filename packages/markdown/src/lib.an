// markdown: block scanner for document ingestion, stored column-wise.
//
// Recognized blocks (one pass, bounded, no I/O):
//   kind 1 heading     ATX `#`..`######`; level = marker count; span = title text
//   kind 2 paragraph   consecutive plain lines; level = 0
//   kind 3 code_fence  ``` or ~~~ (3+); span = body between fences; level = 0
//   kind 4 list_item   `-`, `*`, `+`, `1.` or `1)` plus a space; level = indent / 2 + 1;
//                      following plain lines continue the item
// `start..end` are byte offsets into the source, so `slice(doc, start, end)`
// returns the block text. Words are whitespace-separated runs; sentences end
// at `.`, `!` or `?` before whitespace or the end (code fences count none).
pub struct BlockSpan {
    kind: int,
    start: int,
    end: int,
    level: int,
    words: int,
    sentences: int
}
pub soa vector Blocks(BlockSpan);
@effect(no_alloc, no_io, bounded)
fn is_space(c: int) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12;
}
@effect(no_alloc, no_io, bounded)
fn clamp(v: int, lo: int, hi: int) -> int {
    if v < lo {
        return lo;
    }
    if v > hi {
        return hi;
    }
    return v;
}
@effect(no_alloc, no_io, bounded)
pub fn count_words_in_range(doc: &str, start: int, end: int) -> int {
    let s = clamp(start, 0, len(doc));
    let e = clamp(end, s, len(doc));
    let mut words = 0;
    let mut in_word = false;
    for i in s..e {
        if is_space(byte_at(doc, i)) {
            in_word = false;
        } else if !in_word {
            in_word = true;
            words = words + 1;
        }
    }
    return words;
}
@effect(no_alloc, no_io, bounded)
pub fn count_sentences_in_range(doc: &str, start: int, end: int) -> int {
    let s = clamp(start, 0, len(doc));
    let e = clamp(end, s, len(doc));
    let mut sentences = 0;
    let mut open = false;
    for i in s..e {
        let c = byte_at(doc, i);
        if c == 46 || c == 33 || c == 63 {
            if open &&(i + 1 == e || is_space(byte_at(doc, i + 1))) {
                sentences = sentences + 1;
                open = false;
            }
        } else if !is_space(c) {
            open = true;
        }
    }
    if open {
        sentences = sentences + 1;
    }
    return sentences;
}
@effect(no_alloc, no_io, bounded)
pub fn count_kind(blocks: &Blocks, kind: int) -> int {
    let mut count = 0;
    for b in &blocks {
        if b.kind == kind {
            count = count + 1;
        }
    }
    return count;
}
// Leading spaces of the line, a tab counting as 4.
@effect(no_alloc, no_io, bounded)
fn indent_width(doc: &str, s: int, e: int) -> int {
    let mut width = 0;
    for i in s..e {
        let c = byte_at(doc, i);
        if c == 32 {
            width = width + 1;
        } else if c == 9 {
            width = width + 4;
        } else {
            return width;
        }
    }
    return width;
}
@effect(no_alloc, no_io, bounded)
fn first_non_space(doc: &str, s: int, e: int) -> int {
    for i in s..e {
        let c = byte_at(doc, i);
        if c != 32 && c != 9 {
            return i;
        }
    }
    return e;
}
// End offset with trailing whitespace removed (never below s).
@effect(no_alloc, no_io, bounded)
fn rtrim(doc: &str, s: int, e: int) -> int {
    for k in 0..e - s {
        if !is_space(byte_at(doc, e - 1 - k)) {
            return e - k;
        }
    }
    return s;
}
@effect(no_alloc, no_io, bounded)
fn is_blank(doc: &str, s: int, e: int) -> bool {
    return rtrim(&doc, s, e) == s;
}
// Length of a ``` / ~~~ run (>= 3) opening the line after <= 3 spaces, else 0.
@effect(no_alloc, no_io, bounded)
fn fence_run(doc: &str, s: int, e: int) -> int {
    if indent_width(&doc, s, e) > 3 {
        return 0;
    }
    let p = first_non_space(&doc, s, e);
    if p >= e {
        return 0;
    }
    let c = byte_at(doc, p);
    if c != 96 && c != 126 {
        return 0;
    }
    let mut run = 0;
    for i in p..e {
        if byte_at(doc, i) != c {
            break;
        }
        run = run + 1;
    }
    if run < 3 {
        return 0;
    }
    return run;
}
@effect(no_alloc, no_io, bounded)
fn closes_fence(doc: &str, s: int, e: int, fence_char: int, fence_len: int) -> bool {
    let run = fence_run(&doc, s, e);
    if run < fence_len {
        return false;
    }
    let p = first_non_space(&doc, s, e);
    if byte_at(doc, p) != fence_char {
        return false;
    }
    return is_blank(&doc, p + run, e);
}
// ATX heading level 1..=6, or 0.
@effect(no_alloc, no_io, bounded)
fn heading_level(doc: &str, s: int, e: int) -> int {
    if indent_width(&doc, s, e) > 3 {
        return 0;
    }
    let p = first_non_space(&doc, s, e);
    let mut level = 0;
    for i in p..e {
        if byte_at(doc, i) != 35 {
            break;
        }
        level = level + 1;
    }
    if level == 0 || level > 6 {
        return 0;
    }
    if p + level < e && !is_space(byte_at(doc, p + level)) {
        return 0;
    }
    return level;
}
// Title end: trailing spaces and an optional closing `#` run (after a space) removed.
@effect(no_alloc, no_io, bounded)
fn heading_content_end(doc: &str, cs: int, e: int) -> int {
    let ce = rtrim(&doc, cs, e);
    let mut k = ce;
    for t in 0..ce - cs {
        if byte_at(doc, ce - 1 - t) != 35 {
            break;
        }
        k = ce - 1 - t;
    }
    if k == ce {
        return ce;
    }
    if k == cs || is_space(byte_at(doc, k - 1)) {
        return rtrim(&doc, cs, k);
    }
    return ce;
}
// Offset of the item text after a list marker and its space, or -1.
@effect(no_alloc, no_io, bounded)
fn list_content_start(doc: &str, s: int, e: int) -> int {
    let p = first_non_space(&doc, s, e);
    if p >= e {
        return -1;
    }
    let c = byte_at(doc, p);
    let mut after = -1;
    if c == 45 || c == 42 || c == 43 {
        after = p + 1;
    } else if c >= 48 && c <= 57 {
        for i in p..clamp(p + 10, p, e) {
            let d = byte_at(doc, i);
            if d == 46 || d == 41 {
                after = i + 1;
                break;
            }
            if d < 48 || d > 57 {
                break;
            }
        }
    }
    if after < 0 {
        return -1;
    }
    if after == e {
        return e;
    }
    let sep = byte_at(doc, after);
    if sep != 32 && sep != 9 {
        return -1;
    }
    return first_non_space(&doc, after, e);
}
@effect(no_io, bounded)
fn push_block(blocks: &mut Blocks, doc: &str, kind: int, start: int, end: int, level: int) {
    let mut sentences = 0;
    if kind != 3 {
        sentences = count_sentences_in_range(&doc, start, end);
    }
    let words = count_words_in_range(&doc, start, end);
    push(blocks, BlockSpan { kind: kind, start: start, end: end, level: level, words: words, sentences: sentences });
}
@effect(no_io, bounded)
pub fn scan_markdown(doc: &str) -> Blocks {
    let n = len(doc);
    let mut blocks = Blocks();
    let mut line_start = 0;
    // The open paragraph or list item (kind 0 = none).
    let mut pending_kind = 0;
    let mut pending_start = 0;
    let mut pending_end = 0;
    let mut pending_level = 0;
    let mut in_fence = false;
    let mut fence_char = 0;
    let mut fence_len = 0;
    let mut body_start = 0;
    let mut body_end = 0;
    for i in 0..n + 1 {
        if i == n || byte_at(doc, i) == 10 {
            let s = line_start;
            let mut e = i;
            if e > s && byte_at(doc, e - 1) == 13 {
                e = e - 1;
            }
            line_start = i + 1;
            // A final newline does not start another line.
            if i < n || s < n {
                if in_fence {
                    if closes_fence(&doc, s, e, fence_char, fence_len) {
                        push_block(&mut blocks, &doc, 3, body_start, body_end, 0);
                        in_fence = false;
                    } else {
                        body_end = e;
                    }
                } else {
                    let run = fence_run(&doc, s, e);
                    let level = heading_level(&doc, s, e);
                    let item = list_content_start(&doc, s, e);
                    let blank = is_blank(&doc, s, e);
                    let starts_block = run > 0 || blank || level > 0 || item >= 0;
                    if starts_block && pending_kind != 0 {
                        push_block(&mut blocks, &doc, pending_kind, pending_start, pending_end, pending_level);
                        pending_kind = 0;
                    }
                    if run > 0 {
                        in_fence = true;
                        fence_char = byte_at(doc, first_non_space(&doc, s, e));
                        fence_len = run;
                        body_start = clamp(i + 1, 0, n);
                        body_end = body_start;
                    } else if level > 0 {
                        let cs = first_non_space(&doc, first_non_space(&doc, s, e) + level, e);
                        push_block(&mut blocks, &doc, 1, cs, heading_content_end(&doc, cs, e), level);
                    } else if item >= 0 {
                        pending_kind = 4;
                        pending_start = item;
                        pending_end = rtrim(&doc, item, e);
                        pending_level = indent_width(&doc, s, e) / 2 + 1;
                    } else if !blank {
                        if pending_kind == 0 {
                            pending_kind = 2;
                            pending_start = first_non_space(&doc, s, e);
                            pending_level = 0;
                        }
                        pending_end = rtrim(&doc, s, e);
                    }
                }
            }
        }
    }
    if in_fence {
        push_block(&mut blocks, &doc, 3, body_start, body_end, 0);
    } else if pending_kind != 0 {
        push_block(&mut blocks, &doc, pending_kind, pending_start, pending_end, pending_level);
    }
    return blocks;
}
// Library packages carry an empty entry point so `anode check <package>` accepts them.
fn main() {}
// ---------------------------------------------------------------- tests
fn scan(doc: &text) -> Blocks {
    let mut out = Blocks();
    borrow v = region(doc, 0, len(doc)) {
        out = scan_markdown(&v);
    }
    return out;
}
fn block_is(blocks: &Blocks, i: int, kind: int, level: int, words: int, sentences: int) -> bool {
    let mut ok = false;
    borrow b = at(blocks, i) {
        ok = b.kind == kind && b.level == level && b.words == words && b.sentences == sentences;
    }
    return ok;
}
fn block_text(doc: &text, blocks: &Blocks, i: int) -> text {
    let mut s = 0;
    let mut e = 0;
    borrow b = at(blocks, i) {
        s = b.start;
        e = b.end;
    }
    return slice(doc, s, e);
}
test headings_paragraphs_lists_and_fences() {
    let doc = "# Title\n\nFirst paragraph has five words. And two sentences!\nStill same paragraph.\n\n## Sub ##\n- item one\n- item two is longer\n  1. nested ordered\n```rust\nfn main() {}\nlet x = 1;\n```\nTrailing text without terminator";
    let blocks = scan(&doc);
    assert len(blocks) == 8;
    let b0 = block_is(&blocks, 0, 1, 1, 1, 1);
    assert b0;
    let t0 = block_text(&doc, &blocks, 0);
    let t0_ok = text_eq(t0, "Title");
    assert t0_ok;
    let b1 = block_is(&blocks, 1, 2, 0, 11, 3);
    assert b1;
    let t1 = block_text(&doc, &blocks, 1);
    let t1_ok = text_eq(t1, "First paragraph has five words. And two sentences!\nStill same paragraph.");
    assert t1_ok;
    let b2 = block_is(&blocks, 2, 1, 2, 1, 1);
    assert b2;
    let t2 = block_text(&doc, &blocks, 2);
    let t2_ok = text_eq(t2, "Sub");
    assert t2_ok;
    let b3 = block_is(&blocks, 3, 4, 1, 2, 1);
    let b4 = block_is(&blocks, 4, 4, 1, 4, 1);
    let b5 = block_is(&blocks, 5, 4, 2, 2, 1);
    assert b3 && b4 && b5;
    let t5 = block_text(&doc, &blocks, 5);
    let t5_ok = text_eq(t5, "nested ordered");
    assert t5_ok;
    let b6 = block_is(&blocks, 6, 3, 0, 7, 0);
    assert b6;
    let t6 = block_text(&doc, &blocks, 6);
    let t6_ok = text_eq(t6, "fn main() {}\nlet x = 1;");
    assert t6_ok;
    let b7 = block_is(&blocks, 7, 2, 0, 4, 1);
    assert b7;
    let headings = count_kind(&blocks, 1);
    let items = count_kind(&blocks, 4);
    assert headings == 2 && items == 3;
}
test fences_keep_markdown_literal_and_may_be_unterminated() {
    let doc = "~~~~\n# not a heading\n- not an item\n~~~\n~~~~\nafter\r\n\r\n```\nopen fence";
    let blocks = scan(&doc);
    assert len(blocks) == 3;
    let code = block_is(&blocks, 0, 3, 0, 9, 0);
    assert code;
    let t0 = block_text(&doc, &blocks, 0);
    let t0_ok = text_eq(t0, "# not a heading\n- not an item\n~~~");
    assert t0_ok;
    let after = block_is(&blocks, 1, 2, 0, 1, 1);
    assert after;
    let t1 = block_text(&doc, &blocks, 1);
    let t1_ok = text_eq(t1, "after");
    assert t1_ok;
    let open = block_is(&blocks, 2, 3, 0, 2, 0);
    assert open;
}
test list_continuation_and_non_headings() {
    let doc = "* first item\n  continues here.\n+ second\n#hashtag is text\nC# stays ##\n####### seven";
    let blocks = scan(&doc);
    assert len(blocks) == 2;
    let first = block_is(&blocks, 0, 4, 1, 4, 1);
    assert first;
    let second = block_is(&blocks, 1, 4, 1, 1 + 3 + 3 + 2, 1);
    assert second;
    let t1 = block_text(&doc, &blocks, 1);
    let t1_ok = text_eq(t1, "second\n#hashtag is text\nC# stays ##\n####### seven");
    assert t1_ok;
    let empty = "";
    let none = scan(&empty);
    assert len(none) == 0;
    let blank = "\n   \n\n";
    let none2 = scan(&blank);
    assert len(none2) == 0;
}
test word_and_sentence_counts() {
    let doc = "Pi is 3.14 roughly... Really?! Yes.  ";
    let mut w = 0;
    let mut s = 0;
    let mut part = 0;
    let mut clamped = 0;
    let mut backwards = 0;
    borrow v = region(doc, 0, len(doc)) {
        w = count_words_in_range(&v, 0, len(v));
        s = count_sentences_in_range(&v, 0, len(v));
        part = count_words_in_range(&v, 0, 5);
        clamped = count_words_in_range(&v, -10, 1000);
        backwards = count_words_in_range(&v, 9, 3);
    }
    assert w == 6;
    assert s == 3;
    assert part == 2;
    assert clamped == 6;
    assert backwards == 0;
}
